{
  "manifest_version": 3,
  "name": "Page Saver",
  "version": "0.1.0",
  "description": "Save the current tab to a named list instead of leaving it open.",
  "minimum_chrome_version": "114",
  "permissions": ["tabs", "bookmarks", "storage", "contextMenus", "favicon"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save page to a list",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "manage.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Save current tab to a list"
    }
  }
}
